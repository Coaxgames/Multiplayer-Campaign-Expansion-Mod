#the mod name as displayed in-game
displayName: "Multiplayer Campaign Expansion Mod"

#the internal name of your mod
name: "MCEM"

#your name
author: "Xaon4207"

#the fully qualified main class of the mod. Target: MCEM.Main
main: "MCEM.Main"

#the mod description as seen in the mod dialog
description: '''
Allows clients to pause during a campaign hosting session. More features are planned.
'''

#the mod version
version: "3.2"

#the minimum game build required to run this mod
minGameVersion: "160.5"

#this is a java mod
java: true
